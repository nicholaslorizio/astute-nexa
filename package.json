{
  "name": "astute-nexa",
  "version": "0.1.0",
  "description": "Astute Nexa: docs, sheets, slides, chat and calls, mail, calendar and files in one free, self-hosted workspace",
  "main": "server/index.js",
  "scripts": {
    "start": "node bin/nexa.js --no-open",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "docx": "^9.16.0",
    "domutils": "^4.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.6.1",
    "pptxgenjs": "^4.0.1",
    "sanitize-html": "^2.18.2",
    "ws": "^8.23.0"
  },
  "type": "commonjs",
  "overrides": {
    "image-size": "^2.0.3",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.5"
  },
