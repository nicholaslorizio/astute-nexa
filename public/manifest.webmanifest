{
  "name": "Astute Nexa",
  "short_name": "Nexa",
  "description": "Docs, sheets, slides, chat, calls, mail, calendar and files in one workspace.",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0A0E1C",
  "theme_color": "#6D4BFF",
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New document", "short_name": "Write", "url": "/#/home?new=doc" },
    { "name": "Huddle", "url": "/#/huddle" },
    { "name": "Relay mail", "url": "/#/relay" },
    { "name": "Vault files", "url": "/#/vault" }
  ]
}
